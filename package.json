{
  "name": "edmilson-cell-premium",
  "version": "3.1.3",
  "private": true,
  "description": "Edmilson Cell Premium - aplicativo local Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check electron/main.cjs && node --check scripts/check-app.cjs && node scripts/check-app.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.edmilsoncell.premium",
    "productName": "Edmilson Cell Premium",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "logo-edmilson-cell.png",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Edmilson Cell Premium",
      "artifactName": "Edmilson-Cell-Premium-Setup-${version}.${ext}"
    }
  }
}
